@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Login - HRMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; height: 100vh; }
        .login-container { max-width: 400px; margin: auto; padding: 20px; background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-container">
            <h2 class="text-center mb-4">HRMS Login</h2>
            <div class="alert alert-danger" data-bind="visible: errorMessage, text: errorMessage" style="display: none;"></div>
            <form data-bind="submit: login">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" data-bind="value: username" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" data-bind="value: password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign In</button>
                <div class="mt-3 text-center">
                    <a href="/Account/Register">Don't have an account? Register</a>
                </div>
            </form>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/knockout/3.5.1/knockout-latest.js"></script>
    <script src="/js/auth.js"></script>
    <script>
        ko.applyBindings(new LoginViewModel());
    </script>
</body>
</html>