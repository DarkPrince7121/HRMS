@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#employeeModal" data-bind="click: resetForm">Add Employee</button>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search name or email..." data-bind="value: searchTerm, valueUpdate: 'keyup', event: { keyup: applyFilters }">
            </div>
            <div class="col-md-4">
                <select class="form-select" data-bind="options: departments, optionsText: 'name', optionsValue: 'id', optionsCaption: 'All Departments', value: selectedDepartmentId, event: { change: applyFilters }"></select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-secondary" data-bind="click: resetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="employeesTable" class="table table-striped w-100">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: isEdit() ? 'Edit Employee' : 'Add Employee'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: currentEmployee">
                <div class="mb-3">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" data-bind="value: firstName">
                </div>
                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" data-bind="value: lastName">
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" data-bind="value: email">
                </div>
                <div class="mb-3">
                    <label class="form-label">Department</label>
                    <select class="form-select" data-bind="options: $parent.departments, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Select Department', value: departmentId"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveEmployee">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/employees.js"></script>
}