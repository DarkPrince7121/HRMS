@{ ViewData["Title"] = "Dashboard"; }

<div id="pageContent">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h2 class="fw-bold text-dark mb-1">Workspace Overview</h2>
            <p class="text-muted small">Real-time metrics for your organization</p>
        </div>
        <div class="text-muted small">
            <i class="far fa-calendar me-1"></i> @DateTime.Now.ToString("MMM dd, yyyy")
        </div>
    </div>

    <div data-bind="visible: isLoading" class="text-center py-5 my-5">
        <div class="spinner-grow text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted fw-medium">Loading dashboard statistics...</p>
    </div>

    <div data-bind="visible: error, text: error" class="alert alert-danger shadow-sm border-0" style="display:none;"></div>

    <div class="row g-4" data-bind="visible: !isLoading()" style="display:none;">
        <div class="col-md-4">
            <div class="card border-0 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                            <i class="fas fa-users fa-lg text-primary"></i>
                        </div>
                        <div class="text-xs fw-bold text-muted text-uppercase tracking-wider">Total Employees</div>
                    </div>
                    <div class="h1 mb-0 fw-bold text-dark" data-bind="text: employeeCount">0</div>
                    <div class="mt-3 text-success small">
                        <i class="fas fa-arrow-up me-1"></i>
                        <span>Updated just now</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 p-3 rounded-4 me-3">
                            <i class="fas fa-building fa-lg text-success"></i>
                        </div>
                        <div class="text-xs fw-bold text-muted text-uppercase tracking-wider">Active Departments</div>
                    </div>
                    <div class="h1 mb-0 fw-bold text-dark" data-bind="text: departmentCount">0</div>
                    <div class="mt-3 text-muted small">
                        <span>Organization units</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 p-3 rounded-4 me-3">
                            <i class="fas fa-calendar-check fa-lg text-info"></i>
                        </div>
                        <div class="text-xs fw-bold text-muted text-uppercase tracking-wider">Pending Leaves</div>
                    </div>
                    <div class="h1 mb-0 fw-bold text-dark" data-bind="text: activeLeaveCount">0</div>
                    <div class="mt-3 text-warning small">
                        <i class="fas fa-exclamation-circle me-1"></i>
                        <span>Needs approval</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <div class="d-flex align-items-center mb-4">
            <h4 class="fw-bold text-dark mb-0">Quick Access</h4>
            <div class="ms-3 flex-grow-1 border-bottom border-light"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <a href="/Employees" class="text-decoration-none">
                    <div class="card h-100 border-0 bg-white p-2">
                        <div class="card-body text-center p-4">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <i class="fas fa-user-friends text-primary fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Employees</h6>
                            <p class="text-muted small">View directory</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Attendance" class="text-decoration-none">
                    <div class="card h-100 border-0 bg-white p-2">
                        <div class="card-body text-center p-4">
                            <div class="bg-success bg-opacity-10 rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <i class="fas fa-fingerprint text-success fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Attendance</h6>
                            <p class="text-muted small">Track hours</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Leave" class="text-decoration-none">
                    <div class="card h-100 border-0 bg-white p-2">
                        <div class="card-body text-center p-4">
                            <div class="bg-info bg-opacity-10 rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <i class="fas fa-paper-plane text-info fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Requests</h6>
                            <p class="text-muted small">Leave portal</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Payroll" class="text-decoration-none">
                    <div class="card h-100 border-0 bg-white p-2">
                        <div class="card-body text-center p-4">
                            <div class="bg-warning bg-opacity-10 rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <i class="fas fa-wallet text-warning fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Payroll</h6>
                            <p class="text-muted small">Salary slips</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new DashboardViewModel(), el);
            }
        });
    </script>
}