@{
    ViewData["Title"] = "Dashboard";
}

<div id="pageContent">
    <div class="text-center mb-4">
        <h1 class="display-4">HRMS Dashboard</h1>
        <p class="lead">High-level metrics and visual summaries</p>
    </div>

    <div data-bind="visible: isLoading" class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div data-bind="visible: error, text: error" class="alert alert-danger" style="display:none;"></div>

    <div class="row" data-bind="visible: !isLoading()" style="display:none;">
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-primary shadow">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Total Employees</div>
                            <div class="h2 mb-0 font-weight-bold" data-bind="text: employeeCount">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Departments</div>
                            <div class="h2 mb-0 font-weight-bold" data-bind="text: departmentCount">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-building fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-white bg-info shadow">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Active Leaves</div>
                            <div class="h2 mb-0 font-weight-bold" data-bind="text: activeLeaveCount">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Departments</h5>
                    <p class="card-text">Manage organization departments.</p>
                    <a href="/Departments" class="btn btn-outline-primary btn-sm">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Employees</h5>
                    <p class="card-text">Manage employee records.</p>
                    <a href="/Employees" class="btn btn-outline-primary btn-sm">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Attendance</h5>
                    <p class="card-text">Track employee attendance.</p>
                    <a href="/Attendance" class="btn btn-outline-primary btn-sm">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Leaves</h5>
                    <p class="card-text">Manage leave requests.</p>
                    <a href="/Leave" class="btn btn-outline-primary btn-sm">Manage</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new DashboardViewModel(), el);
            }
        });
    </script>
}