@{
    ViewData["Title"] = "Payroll Management";
}

<div id="pageContent" class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Payroll Management</h2>
        <div>
            <div class="input-group">
                <input type="month" class="form-control" data-bind="value: selectedMonth" />
                <button class="btn btn-primary" data-bind="click: generatePayroll, disable: isGenerating">
                    <span data-bind="visible: !isGenerating()">Generate Payroll</span>
                    <span data-bind="visible: isGenerating">Generating...</span>
                </button>
            </div>
        </div>
    </div>
    <hr />

    <table id="payrollTable" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Employee Name</th>
                <th>Pay Date</th>
                <th>Gross Pay</th>
                <th>Deductions</th>
                <th>Net Pay</th>
                <th>Breakdown</th>
                <th>Status</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/payroll.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el) {
                var existingVM = ko.dataFor(el);
                if (!existingVM) {
                    var vm = new PayrollViewModel();
                    ko.applyBindings(vm, el);
                    vm.initDataTable();
                } else if (existingVM.initDataTable) {
                    existingVM.initDataTable();
                }
            }
        });
    </script>
}