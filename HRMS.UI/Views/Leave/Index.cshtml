@{ ViewData["Title"] = "Leave Requests"; }

<div id="pageContent">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Leave Management</h2>
            <p class="text-muted small mb-0">Process and track employee time-off requests</p>
        </div>
        <button class="btn btn-primary shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#leaveModal" data-bind="click: resetForm">
            <i class="fas fa-paper-plane me-2"></i>
            <span>Request Leave</span>
        </button>
    </div>

    <div class="card border-0 bg-white shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="leavesTable" class="table table-hover align-middle mb-0 w-100">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="px-4 py-3 border-0">Employee</th>
                            <th class="py-3 border-0">Type</th>
                            <th class="py-3 border-0">Period</th>
                            <th class="py-3 border-0">Status</th>
                            <th class="px-4 py-3 border-0 text-end">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="leaveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <h5 class="modal-title fw-bold">New Request</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Employee</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 shadow-none" data-bind="options: employees, optionsText: function(item) { return item.firstName + ' ' + item.lastName; }, optionsValue: 'id', value: currentLeave.employeeId, optionsCaption: 'Select Employee...'" required></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Leave Category</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 shadow-none" data-bind="value: currentLeave.leaveType">
                                <option value="Sick Leave">Sick Leave</option>
                                <option value="Casual Leave">Casual Leave</option>
                                <option value="Annual Leave">Annual Leave</option>
                                <option value="Maternity Leave">Maternity Leave</option>
                                <option value="Paternity Leave">Paternity Leave</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">From Date</label>
                            <input type="date" class="form-control bg-light border-0 py-2 shadow-none" data-bind="value: currentLeave.startDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">To Date</label>
                            <input type="date" class="form-control bg-light border-0 py-2 shadow-none" data-bind="value: currentLeave.endDate" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Reason for Leave</label>
                            <textarea class="form-control bg-light border-0 py-2 shadow-none" rows="3" placeholder="Detailed explanation..." data-bind="value: currentLeave.reason" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light px-4 fw-medium" data-bs-dismiss="modal">Discard</button>
                    <button type="button" class="btn btn-primary px-4 fw-medium shadow-sm" data-bind="click: requestLeave">Submit Request</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/leaves.js"></script>
}