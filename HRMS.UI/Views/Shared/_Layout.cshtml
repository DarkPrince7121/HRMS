<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --hrms-primary: #4e73df;
            --hrms-success: #1cc88a;
            --hrms-info: #36b9cc;
            --hrms-warning: #f6c23e;
            --hrms-danger: #e74a3b;
            --hrms-dark: #2c3e50;
            --hrms-light: #f8f9fc;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #f4f7f6;
            color: #2d3436;
        }

        .navbar {
            background: white !important;
            box-shadow: 0 1px 15px rgba(0,0,0,.04);
            padding: 0.75rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--hrms-dark) !important;
        }

        .nav-link {
            font-weight: 500;
            color: #636e72 !important;
            transition: all 0.2s;
            padding: 0.5rem 1rem !important;
            border-radius: 0.5rem;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--hrms-primary) !important;
            background: rgba(78, 115, 223, 0.05);
        }

        .notification-badge {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 10px;
            height: 10px;
            background-color: var(--hrms-danger);
            border: 2px solid white;
            border-radius: 50%;
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.15);
            border-radius: 0.75rem;
        }

        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
        }

        .btn-primary {
            background-color: var(--hrms-primary);
            border-color: var(--hrms-primary);
            font-weight: 600;
            border-radius: 0.5rem;
            padding: 0.5rem 1.25rem;
        }

        footer {
            background: white;
            border-top: 1px solid #edf2f7;
            padding: 2.5rem 0;
            margin-top: 4rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary p-2 rounded-3 me-2">
                        <i class="fas fa-users-cog text-white"></i>
                    </div>
                    <span>HRMS</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Employees" asp-action="Index">Directory</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="mgmtDropdown" data-bs-toggle="dropdown">Management</a>
                            <ul class="dropdown-menu p-2">
                                <li><a class="dropdown-item rounded-2" asp-controller="Departments" asp-action="Index">Departments</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Designations" asp-action="Index">Designations</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Holidays" asp-action="Index">Holidays</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Attendance" asp-action="Index">Attendance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Leave" asp-action="Index">Leaves</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payroll" asp-action="Index">Payroll</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Applications" id="nav-applications-link">Applications</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" data-bs-toggle="dropdown">System</a>
                                <ul class="dropdown-menu p-2">
                                    <li><a class="dropdown-item rounded-2" asp-controller="Audit" asp-action="Index">Audit Logs</a></li>
                                    <li><a class="dropdown-item rounded-2" asp-controller="Settings" asp-action="Index">Settings</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown me-lg-3" id="notificationArea">
                            <a class="nav-link p-2 position-relative" href="#" id="notificationDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-bell fs-5"></i>
                                <span class="notification-badge" data-bind="visible: unreadCount() > 0"></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end p-0 shadow overflow-hidden" style="width: 350px;">
                                <li class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center bg-light-subtle">
                                    <h6 class="mb-0 fw-bold">Notifications</h6>
                                    <button class="btn btn-sm btn-link text-primary p-0" data-bind="click: markAllRead, visible: unreadCount() > 0">Mark all read</button>
                                </li>
                                <div style="max-height: 400px; overflow-y: auto;">
                                    <!-- ko foreach: notifications -->
                                    <li class="px-4 py-3 border-bottom" data-bind="css: { 'bg-white': isRead, 'bg-light-subtle': !isRead }">
                                        <div class="d-flex">
                                            <div class="flex-grow-1">
                                                <div class="small text-dark mb-1" data-bind="text: message"></div>
                                                <div class="text-muted small d-flex align-items-center">
                                                    <i class="far fa-clock me-1"></i>
                                                    <span data-bind="text: createdAt"></span>
                                                </div>
                                            </div>
                                            <div class="ms-2" data-bind="visible: !isRead">
                                                <div class="bg-primary rounded-circle" style="width: 8px; height: 8px;"></div>
                                            </div>
                                        </div>
                                    </li>
                                    <!-- /ko -->
                                    <li class="px-4 py-5 text-center" data-bind="visible: notifications().length === 0">
                                        <div class="bg-light rounded-circle p-3 d-inline-block mb-3">
                                            <i class="fas fa-bell-slash text-muted fs-4"></i>
                                        </div>
                                        <p class="text-muted small mb-0">All caught up!</p>
                                    </li>
                                </div>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" data-bs-toggle="dropdown">
                                <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span class="d-none d-lg-inline">@(User.Identity?.Name ?? "User")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end p-2">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item rounded-2 text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4" id="mainContent">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-muted small fw-medium">&copy; @DateTime.Now.Year HRMS Cloud. All rights reserved.</span>
                </div>
                <div class="col-md-6">
                    <ul class="list-inline text-center text-md-end mb-0">
                        <li class="list-inline-item mx-2"><a href="#" class="text-muted text-decoration-none small fw-medium">Privacy</a></li>
                        <li class="list-inline-item mx-2"><a href="#" class="text-muted text-decoration-none small fw-medium">Terms</a></li>
                        <li class="list-inline-item mx-2"><a href="#" class="text-muted text-decoration-none small fw-medium text-primary">Support</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/knockout/3.5.1/knockout-latest.js"></script>
    
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script src="/js/notifications.js"></script>
    <script src="/js/applications.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>