<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label small fw-semibold text-muted">First Name</label>
        <input type="text" class="form-control bg-light border-0 py-2 shadow-none" placeholder="e.g. John" data-bind="value: firstName" required>
    </div>
    <div class="col-md-6">
        <label class="form-label small fw-semibold text-muted">Last Name</label>
        <input type="text" class="form-control bg-light border-0 py-2 shadow-none" placeholder="e.g. Doe" data-bind="value: lastName" required>
    </div>
    <div class="col-12" data-bind="visible: isAdmin">
        <label class="form-label small fw-semibold text-muted">Department</label>
        <select class="form-select bg-light border-0 py-2 rounded-3 shadow-none" data-bind="options: departments, optionsText: 'name', optionsValue: 'id', value: departmentId"></select>
    </div>
    <div class="col-12" data-bind="visible: isAdmin">
        <label class="form-label small fw-semibold text-muted">Annual Base Salary</label>
        <div class="input-group bg-light rounded-3 overflow-hidden">
            <span class="input-group-text bg-transparent border-0">$</span>
            <input type="number" class="form-control bg-transparent border-0 py-2 shadow-none" placeholder="0.00" data-bind="value: baseSalary">
        </div>
    </div>
</div>