@{ ViewData["Title"] = "Attendance"; }

<div id="pageContent">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Attendance Tracking</h2>
            <p class="text-muted small mb-0">Log and monitor daily organization attendance</p>
        </div>
        <button class="btn btn-primary shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#attendanceModal" data-bind="click: resetForm">
            <i class="fas fa-calendar-check me-2"></i>
            <span>Mark Attendance</span>
        </button>
    </div>

    <div class="card border-0 bg-white overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="attendanceTable" class="table table-hover align-middle mb-0 w-100">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="px-4 py-3 border-0">Employee</th>
                            <th class="py-3 border-0">Date</th>
                            <th class="py-3 border-0">Status</th>
                            <th class="px-4 py-3 border-0">Remarks</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="attendanceModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <h5 class="modal-title fw-bold">Log Attendance</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Employee</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 shadow-none" data-bind="options: employees, optionsText: function(item) { return item.firstName + ' ' + item.lastName; }, optionsValue: 'id', value: currentAttendance.employeeId, optionsCaption: 'Select Employee...'" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Log Date</label>
                            <input type="date" class="form-control bg-light border-0 py-2 shadow-none" data-bind="value: currentAttendance.date" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Status</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 shadow-none" data-bind="value: currentAttendance.status">
                                <option value="Present">Present</option>
                                <option value="Absent">Absent</option>
                                <option value="Late">Late</option>
                                <option value="HalfDay">Half Day</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Remarks</label>
                            <textarea class="form-control bg-light border-0 py-2 shadow-none" rows="2" placeholder="Any additional notes..." data-bind="value: currentAttendance.remarks"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light px-4 fw-medium" data-bs-dismiss="modal">Discard</button>
                    <button type="button" class="btn btn-primary px-4 fw-medium shadow-sm" data-bind="click: markAttendance">Save Entry</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendance.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new AttendanceViewModel(), el);
            }
        });
    </script>
}