@{
    ViewData["Title"] = "Attendance";
}

<div class="container mt-4">
    <h2>Attendance Tracking</h2>
    <hr />

    <div class="mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#attendanceModal">Mark Attendance</button>
    </div>

    <table id="attendanceTable" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Date</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="attendanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark Attendance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-control" data-bind="options: employees, optionsText: function(item) { return item.firstName + ' ' + item.lastName; }, optionsValue: 'id', value: currentAttendance.employeeId, optionsCaption: 'Choose Employee...'" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" data-bind="value: currentAttendance.date" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-control" data-bind="value: currentAttendance.status">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Late">Late</option>
                            <option value="HalfDay">Half Day</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" data-bind="value: currentAttendance.remarks"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bind="click: markAttendance">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendance.js"></script>
}