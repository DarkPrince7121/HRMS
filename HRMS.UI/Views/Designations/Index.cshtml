@{
    ViewData["Title"] = "Designations";
}

<div id="pageContent">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Designations</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#designationModal" data-bind="click: resetForm">Add Designation</button>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search name or description..." data-bind="value: searchTerm, valueUpdate: 'keyup', event: { keyup: applyFilters }">
            </div>
            <div class="col-md-4">
                <button class="btn btn-secondary" data-bind="click: resetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="designationsTable" class="table table-striped w-100">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="designationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: isEdit() ? 'Edit Designation' : 'Add Designation'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: currentDesignation">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" data-bind="value: name">
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" data-bind="value: description"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveDesignation">Save</button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/designations.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new DesignationsViewModel(), el);
            }
        });
    </script>
}