@{
    ViewData["Title"] = "System Settings";
}

<div id="pageContent" class="container">
    <h2>System Settings</h2>
    <div class="row mt-4">
        <div class="col-md-8">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Value</th>
                        <th>Description</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: settings">
                    <tr>
                        <td data-bind="text: key"></td>
                        <td>
                            <input type="text" class="form-control" data-bind="value: value" />
                        </td>
                        <td data-bind="text: description"></td>
                        <td>
                            <button class="btn btn-primary btn-sm" data-bind="click: $parent.updateSetting">Save</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new SettingsViewModel(), el);
            }
        });
    </script>
}