@{
    ViewData["Title"] = "System Settings";
}

<div id="pageContent" class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">System Settings</h2>
        <p class="text-muted small mb-0">Global configuration and system preferences</p>
    </div>

    <div class="row">
        <div class="col-xl-9 col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="px-4 py-3 border-0" style="width: 25%">Setting Key</th>
                                    <th class="py-3 border-0" style="width: 35%">Value</th>
                                    <th class="py-3 border-0">Description</th>
                                    <th class="px-4 py-3 border-0 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: settings">
                                <tr>
                                    <td class="px-4 fw-bold text-dark" data-bind="text: key"></td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm px-3 bg-light border-0" data-bind="value: value" />
                                    </td>
                                    <td class="text-muted small" data-bind="text: description"></td>
                                    <td class="px-4 text-end">
                                        <button class="btn btn-sm btn-primary shadow-sm px-3" data-bind="click: $parent.updateSetting">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="mt-4 p-4 bg-light rounded-3 border">
                <div class="d-flex align-items-center">
                    <i class="fas fa-info-circle text-primary me-3 fa-lg"></i>
                    <div>
                        <h6 class="mb-1 fw-bold">Note on Settings</h6>
                        <p class="mb-0 text-muted small">Changes to system settings may require a page refresh or service restart to take full effect across all modules.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js"></script>
    <script>
        $(document).ready(function () {
            var el = document.getElementById('pageContent');
            if (el && !ko.dataFor(el)) {
                ko.applyBindings(new SettingsViewModel(), el);
            }
        });
    </script>
}
